# Copy this file to ".env" to change settings.
# Vite only exposes variables that start with VITE_ to your code.

# GraphQL endpoint (the dev proxy in vite.config.js forwards /graphql to port 4000)
VITE_GRAPHQL_URL=/graphql

# Any public Tableau view URL (find one on public.tableau.com)
VITE_TABLEAU_URL=https://public.tableau.com/views/Superstore_embedded_800x800/Overview
